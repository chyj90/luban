# ============================================================
# Luban Docker 环境变量配置
# 复制此文件为 .env 后根据需要修改
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=luban123
MYSQL_DATABASE=luban
MYSQL_PORT=3306

# ---------- 后端端口 ----------
BACKEND_PORT=8080

# ---------- 前端端口 ----------
FRONTEND_PORT=80

# ---------- Embedding 服务 ----------
EMBEDDING_PORT=8765
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ---------- 安全密钥（留空则自动生成随机密钥，并持久化到 Volume） ----------
# 首次启动时自动生成并保存，重启后自动复用，登录态不会丢失。
# 如需在多台机器间共享登录态，请手动设置固定值。
# LUBAN_JWT_SECRET 需要至少 256 位（64 个十六进制字符）
# 生成方式：openssl rand -hex 32
LUBAN_JWT_SECRET=
# LUBAN_DATASOURCE_SECRET 需要 Base64 编码的 32 字节密钥
# 生成方式：openssl rand -base64 32
LUBAN_DATASOURCE_SECRET=
# LUBAN_RSA_PRIVATE_KEY 为 RSA 私钥 PEM 内容
# 生成方式：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
LUBAN_RSA_PRIVATE_KEY=

# ---------- 内置大模型配置（复制 .env.docker 为 .env 后填写真实值） ----------
# 首次启动时，这些值会自动 AES 加密存入数据库，前端不可见
LUBAN_LLM_API_KEY=
LUBAN_LLM_ENDPOINT=https://api.deepseek.com/v1
LUBAN_LLM_MODEL=deepseek-chat