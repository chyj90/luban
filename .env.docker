# ============================================================
# Luban Docker 环境变量配置
# 复制此文件为 .env 后根据需要修改
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=luban123
MYSQL_DATABASE=luban
MYSQL_PORT=3306

# ---------- 后端端口 ----------
BACKEND_PORT=8080

# ---------- 前端端口 ----------
FRONTEND_PORT=80

# ---------- Embedding 服务 ----------
EMBEDDING_PORT=8765
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# ---------- 安全密钥（留空则自动生成随机密钥） ----------
# 注意：如果需要在多台机器上共享登录态，请设置固定值
# LUBAN_JWT_SECRET 需要至少 256 位（64 个十六进制字符）
# 生成方式：openssl rand -hex 32
LUBAN_JWT_SECRET=
# LUBAN_DATASOURCE_SECRET 需要 Base64 编码的 32 字节密钥
# 生成方式：openssl rand -base64 32
LUBAN_DATASOURCE_SECRET=
# LUBAN_RSA_PRIVATE_KEY 为 RSA 私钥 PEM 内容
# 生成方式：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
LUBAN_RSA_PRIVATE_KEY=