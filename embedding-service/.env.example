EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_PORT=8765

# Sandbox for algorithm / code execution isolation.
# SANDBOX_RUNTIME: auto(in K8s -> k8s, else docker) | docker | k8s | external
#   docker   : pool of docker containers (dev only; needs /var/run/docker.sock)
#   k8s      : pool of Pods via K8s API (needs RBAC pods+pods/exec; NOT usable in
#              clusters that forbid K8s API access)
#   external : RESTRICTED clusters (no K8s API permission) — sandbox Pods deployed
#              manually (Deployment of luban-sandbox image, agent listens :9000);
#              this service only does health-check & script execution over HTTP.
#              Required: SANDBOX_ENDPOINTS (comma-separated Service/pod URLs).
#              Recommended: SANDBOX_AGENT_TOKEN (same value in sandbox pods).
#              See doc/部署文档.md 附录 G.4.
#   k8s mode extras: SANDBOX_NAMESPACE, SANDBOX_FILES_PVC (readonly /mnt/files),
#              POD_NAME/POD_UID (downward API, ownerReference cascade cleanup)
SANDBOX_ENABLED=false
SANDBOX_RUNTIME=auto
SANDBOX_IMAGE=luban-sandbox:latest
SANDBOX_POOL_SIZE=3
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_TIMEOUT=30
# --- external runtime ---
# SANDBOX_ENDPOINTS=http://luban-sandbox:9000
# SANDBOX_AGENT_TOKEN=change-me-shared-secret
# SANDBOX_AGENT_PORT=9000